# ═══════════════════════════════════════════════════════════════════════════
#  PlanCrest: complete environment reference
# ═══════════════════════════════════════════════════════════════════════════
#  Every setting the project reads, in one file.
#
#  HOW TO USE
#    Server settings (sections 1 to 8)  ->  copy into  server/.env
#    Web app settings (section 9)       ->  copy into  client/.env
#  The same server settings can live in server/config.local.json instead.
#  Real environment variables always win over files.
#
#  NEVER commit .env files. They are git ignored. Only *.example files are
#  meant to be committed.
#
#  Legend:  [REQUIRED]     the server will not start without it
#           [RECOMMENDED]  the app runs, but a feature is missing without it
#           [OPTIONAL]     enable only the features you want
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────── 1. CORE (server) ─────────────────────────────

# Port the API listens on.
PORT=8000

# development | production | test
# production turns on Secure + SameSite=None cookies (needs HTTPS) and hides
# internal error details from API responses.
NODE_ENV=development

# [REQUIRED] MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/plancrest
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/plancrest?retryWrites=true&w=majority
# URL-encode special characters in the password (@ becomes %40, and so on).
DATABASE=mongodb://127.0.0.1:27017/plancrest

# [REQUIRED] Signs login sessions. 32 or more random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=

# [RECOMMENDED] Encrypts integration tokens at rest (AES-256-GCM). 32 or more
# random characters, different from JWT_SECRET. Changing it means every
# integration must be reconnected.
ENCRYPTION_KEY=


# ──────────────────────────── 2. PUBLIC URLS (server) ───────────────────────

# Where the web app is served. Used for CORS, cookies and links in emails.
# Comma separate to allow several origins; the first one is used in links.
#   Dev:   http://localhost:5173
#   Prod:  https://app.example.com
CLIENT_URL=http://localhost:5173

# Where THIS API is reachable from the internet. OAuth providers redirect here
# and GitHub webhooks call it.
#   Dev:   http://localhost:8000
#   Prod:  https://api.example.com
API_PUBLIC_URL=http://localhost:8000

# [OPTIONAL] Override the base URL used in email links and chat deep links.
# Both default to the first CLIENT_URL, so normally leave them unset.
# APP_URL=
# FRONTEND_URL=


# ─────────── 3. EMAIL (server): verification, resets, invites, reminders ────

# gmail | hotmail | yahoo | zoho
EMAIL_SERVICE=gmail

# The mailbox that sends the emails.
EMAIL_USER=

# Gmail: turn on 2 step verification, then create an APP PASSWORD (exactly 16
# characters, shown as 4 groups of 4) at https://myaccount.google.com/apppasswords
# Paste it with no spaces. Your normal Google password will NOT work.
EMAIL_PASS=

# Name shown as the sender.
EMAIL_SENDER_NAME=PlanCrest


# ────────────────── 4. FILE UPLOADS (server): avatars, documents ────────────
# Free account at https://cloudinary.com. Without these, uploads are disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ───────────────────── 5. GOOGLE SIGN IN (server, optional) ─────────────────
# "Continue with Google" uses Firebase Authentication.
#   1. https://console.firebase.google.com : create a project
#   2. Authentication > Sign in method : enable Google
#   3. Authentication > Settings > Authorized domains : add your app's domain
#   4. Use the same project ID here and in the VITE_FIREBASE_* values below
FIREBASE_PROJECT_ID=


# ────────────────────────── 6. AI MODE (server, optional) ───────────────────
# Any OpenAI compatible provider. Providers are tried in LLM_FALLBACK_ORDER;
# each provider's models are tried left to right until one answers.
#   * A rejected key skips that provider.
#   * A missing model or an outage moves on to the next model.
#   * A provider with no key (or a placeholder like "your_key_here") is skipped.
LLM_FALLBACK_ORDER="openrouter,groqcloud,deepseek"

# OpenRouter: https://openrouter.ai/keys   model ids: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODELS="deepseek/deepseek-v4-flash,google/gemini-2.5-flash"
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# GroqCloud: https://console.groq.com/keys
# Model ids differ per key. List yours with:
#   curl -H "Authorization: Bearer $GROQCLOUD_API_KEY" https://api.groq.com/openai/v1/models
GROQCLOUD_API_KEY=
GROQCLOUD_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b"
# GROQCLOUD_BASE_URL=https://api.groq.com/openai/v1

# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS="deepseek-chat"
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Limits: requests per user per hour, and milliseconds per model attempt before falling back.
AI_REQUESTS_PER_HOUR=60
AI_TIMEOUT_MS=60000


# ───────────────── 7. INTEGRATIONS (server, optional) ───────────────────────
# One OAuth app per group. In each console register this redirect URL (use your
# API_PUBLIC_URL as the host):
#     {API_PUBLIC_URL}/api/integrations/<group>/callback
# The Integrations page in the app shows what is and is not configured.

# Google Workspace: Calendar, Drive, Meet, Gmail           group = google
#   https://console.cloud.google.com > APIs & Services: enable the Calendar,
#   Drive and Gmail APIs, then Credentials > OAuth client ID (Web application).
#   Redirect: {API_PUBLIC_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub and GitHub Actions                                 group = github
#   https://github.com/settings/developers > New OAuth App
#   Callback: {API_PUBLIC_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Slack                                                     group = slack
#   https://api.slack.com/apps > Create New App > OAuth & Permissions
#   Redirect: {API_PUBLIC_URL}/api/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Jira, Trello and Microsoft Teams need NOTHING here. People connect them inside
# the app by pasting an API token or an incoming webhook URL.


# ─────────────────────── 8. DEVELOPMENT ONLY (server) ───────────────────────
# `npm run dev:demo` starts an in-memory MongoDB with demo data and ignores
# DATABASE. To skip the first run MongoDB download, point to an existing binary:
# MONGOMS_SYSTEM_BINARY=C:/path/to/mongod.exe


# ═══════════════════════ 9. WEB APP (goes in client/.env) ═══════════════════
# Everything below is bundled into public JavaScript. NEVER put secrets here.
# Restart `npm run dev` or rebuild after changing a value.

# Base URL of the PlanCrest API, including the /api suffix.
#   Dev:   http://localhost:8000/api
#   Prod:  https://api.example.com/api
VITE_API_URL=http://localhost:8000/api

# Google sign in (optional). Firebase console > Project settings > General >
# Your apps > Web app > Config. Public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Direct browser uploads to Cloudinary (optional). Create an UNSIGNED upload
# preset in Cloudinary (Settings > Upload > Upload presets). Never put your API
# secret here.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
