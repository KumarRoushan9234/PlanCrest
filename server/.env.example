# ── Core ─────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
# MongoDB connection string (Atlas or local)
DATABASE=mongodb://127.0.0.1:27017/plancrest
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Encrypts integration tokens at rest (AES-256-GCM). `openssl rand -hex 32`
ENCRYPTION_KEY=

# Where the web app is served (CORS + links in emails). Comma-separate to allow several.
CLIENT_URL=http://localhost:5173
# Public URL of THIS server, used for OAuth callbacks and webhooks
API_PUBLIC_URL=http://localhost:8000

# ── Email (verification, invites, reminders) ─────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_SENDER_NAME=PlanCrest

# ── File uploads ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google sign-in (optional) ────────────────────────────────────────
# Project ID of the Firebase project the web app signs in with
FIREBASE_PROJECT_ID=

# ── AI Mode (optional) ───────────────────────────────────────────────
OPENROUTER_API_KEY=
# Any OpenRouter model id. Change it whenever you like and restart.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
AI_REQUESTS_PER_HOUR=60

# ── Integrations (optional, configure only what you use) ─────────────
# One OAuth app per group. Callback URL: {API_PUBLIC_URL}/api/integrations/<group>/callback
# Google Workspace: Calendar, Drive, Meet, Gmail  (group = google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub and GitHub Actions  (group = github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Slack  (group = slack)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Jira, Trello and Microsoft Teams connect with credentials or webhook URLs
# entered inside the app, so they need nothing here.
