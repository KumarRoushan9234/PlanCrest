# ═══════════════════════════════════════════════════════════════════════════
#  PlanCrest web app configuration (Vite)
# ═══════════════════════════════════════════════════════════════════════════
#  Copy to `.env` (git ignored). Everything here is bundled into the public
#  JavaScript, so NEVER put secrets in this file. Rebuild or restart `npm run
#  dev` after changing a value.
# ═══════════════════════════════════════════════════════════════════════════

# Base URL of the PlanCrest API, including the /api suffix.
#   Dev:   http://localhost:8000/api
#   Prod:  https://api.example.com/api
VITE_API_URL=http://localhost:8000/api


# ── Google sign in via Firebase (optional) ──────────────────────────────────
# Firebase console > Project settings > General > Your apps > Web app > Config.
# Use the same project as FIREBASE_PROJECT_ID in server/.env.
# These values are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=


# ── Browser side uploads to Cloudinary (optional) ───────────────────────────
# Only needed for direct uploads. Create an UNSIGNED upload preset in Cloudinary
# (Settings > Upload > Upload presets). Never put your API secret here.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
